# Docker 全栈环境变量（复制为 deploy/.env.docker 后修改）
# 用法：
#   本地构建：docker compose --env-file deploy/.env.docker -f docker-compose.full.yml up -d --build
#   拉 ACR：  docker compose --env-file deploy/.env.docker -f docker-compose.yml up -d

POSTGRES_USER=printfilm
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=printfilm

SECRET_KEY=change-me-to-a-long-random-string

# 用户端 nginx :8080；管理端 :8081；API 文档 :8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8000,http://127.0.0.1:8000
PUBLIC_BASE_URL=http://localhost:8080

# 启动后将已注册邮箱提权为管理员（逗号分隔，不造号）
# ADMIN_BOOTSTRAP_EMAILS=you@example.com

ARK_MOCK=false
# TokenFree New API（文字 / 生图 / 生视频同一把 Key）
# 申请：https://www.tokenfree.com → 控制台创建 API 密钥（sk-…）
# 也可启动后在管理后台「系统设置 → 模型」填写，不必改本文件
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://www.tokenfree.com/v1
ARK_API_KEY=replace-me
# 与站点预设一致（管理端下拉白名单）
MODEL_LLM=kimi-k2.6
MODEL_IMAGE=seedream-5-0-pro
MODEL_VIDEO=seedance-2-5

BILLING_ENABLED=false
BILLING_MARKUP=1.0
BILLING_SIGNUP_GRANT_FEN=500
BILLING_USD_CNY=7.0

OSS_ENABLED=false

# ---- Agnes AI 引擎（可选；配置 AGNES_API_KEYS 即启用）----
# 多账号 key 池逗号分隔；429 自动轮换。网关默认模型为 agnes-* 时图像/视频自动走 Agnes。
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=sk-agnes-primary
AGNES_API_KEYS=sk-agnes-1,sk-agnes-2,sk-agnes-3
AGNES_TEXT_MODEL=agnes-3.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
AGNES_VIDEO_POLL_INTERVAL=10
AGNES_VIDEO_POLL_TIMEOUT=1800
# 将默认逻辑模型指向 Agnes 即整链切 Agnes；文本可另配 OPENAI_BASE_URL 走 /v1
# MODEL_LLM=agnes-3.0-flash
# MODEL_IMAGE=agnes-image-2.5-flash
# MODEL_VIDEO=agnes-video-2.5-flash
